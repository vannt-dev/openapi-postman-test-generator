{
  "name": "openapi-postman-test-generator",
  "version": "0.3.0",
  "description": "Generate Postman collections and API tests from Swagger/OpenAPI specs",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "bin": {
    "openapi-postman": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/openapi-postman-test-generator.git"
  },
  "bugs": {
    "url": "https://github.com/vannt-dev/openapi-postman-test-generator/issues"
  },
  "homepage": "https://github.com/vannt-dev/openapi-postman-test-generator#readme",
  "keywords": [
    "openapi",
    "swagger",
    "postman",
    "newman",
    "api-testing",
    "test-generator",
    "ai-agent"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "generate": "node dist/index.js",
    "lint": "eslint . && tsc --noEmit",
    "test:smoke": "node test/smoke.js && node test/advanced.js && node test/ai-providers.js",
    "test:e2e": "node test/e2e.js",
    "test": "npm run build && npm run test:smoke && npm run test:e2e",
    "check": "npm run lint && npm test && npm audit --omit=dev",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "js-yaml": "^5.4.1",
    "openai": "^7.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.70.0"
  }
}
